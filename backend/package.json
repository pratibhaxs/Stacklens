{
  "name": "reposcan-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch src/server.js\" \"node --watch src/worker/index.js\"",
    "dev:server": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker/index.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "simple-git": "3.27.0"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "prisma": "5.22.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}